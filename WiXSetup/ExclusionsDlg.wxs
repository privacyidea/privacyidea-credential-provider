<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <UI>
            <Dialog Id="ExclusionsDlg" Width="370" Height="270" Title="[ProductName] - Exclusions Configuration">
                <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Exclusions" />
                <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Configure excluded accounts, groups, and Domain Controllers." />
                <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
                <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

                <!-- Excluded Accounts -->
                <Control Id="ExcludedAccountsLabel" Type="Text" X="20" Y="55" Width="330" Height="15" NoPrefix="yes" Text="Excluded Accounts (separate multiple with semicolon):" />
                <Control Id="ExcludedAccountsEdit" Type="Edit" X="20" Y="70" Width="330" Height="18" Property="EXCLUDED_ACCOUNTS" />
                <Control Id="ExcludedAccountsHelp" Type="Text" X="20" Y="90" Width="330" Height="20" NoPrefix="yes">
                    <Text>Format: DOMAIN\user;.\localuser   (WITH domain/computer prefix!)</Text>
                </Control>

                <!-- Excluded Groups -->
                <Control Id="ExcludedGroupsLabel" Type="Text" X="20" Y="115" Width="330" Height="15" NoPrefix="yes" Text="Excluded Groups (separate multiple with semicolon):" />
                <Control Id="ExcludedGroupsEdit" Type="Edit" X="20" Y="130" Width="330" Height="18" Property="EXCLUDED_GROUPS" />
                <Control Id="ExcludedGroupsHelp" Type="Text" X="20" Y="150" Width="330" Height="20" NoPrefix="yes">
                    <Text>Format: Administrators;Domain Admins   (NO domain prefix!)</Text>
                </Control>

                <!-- Domain Controllers -->
                <Control Id="ExcludedGroupDCsLabel" Type="Text" X="20" Y="175" Width="330" Height="15" NoPrefix="yes" Text="Domain Controllers (separate multiple with semicolon):" />
                <Control Id="ExcludedGroupDCsEdit" Type="Edit" X="20" Y="190" Width="330" Height="18" Property="EXCLUDED_GROUP_DCS" />
                <Control Id="ExcludedGroupDCsHelp" Type="Text" X="20" Y="210" Width="330" Height="20" NoPrefix="yes">
                    <Text>Format: DC01.company.local;DC02.company.local</Text>
                </Control>

                <!-- Navigation buttons -->
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
                    <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
                </Control>
            </Dialog>
        </UI>
    </Fragment>
</Wix>